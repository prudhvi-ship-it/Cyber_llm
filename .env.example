# Local credentials. Copy to .env and fill in keys there.
# The active LLM factory uses OpenRouter, not OPENAI_API_KEY.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Explicit configuration for the documented same-model reproduction run.
FRA_EXPERIMENT_PROFILE=fair_same_model
FRA_FAIR_MODEL=openai/gpt-5
FRA_MEMORY_MODE=disabled
FRA_LLM_TEMPERATURE=0
FRA_LLM_TIMEOUT=180
FRA_LLM_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=8192

# MCP server and tool.
FRA_MCP_SERVER_URL=http://localhost:8000/mcp
FRA_MCP_SEARCH_TOOL=search_forensic_evidence
FRA_MCP_MAX_RESULTS=8

# Serper web research. Set the key to use this configuration.
# NVD_API_KEY is optional. KEV and ATT&CK feeds do not use these keys.
FRA_WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
NVD_API_KEY=
FRA_WEB_SEARCH_RESULTS=10
FRA_WEB_FETCH_MAX_PAGES=10

# Optional if tshark is not on PATH (uncomment and adjust).
# TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
